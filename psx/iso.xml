<?xml version="1.0" encoding="utf-8"?>
<iso_project>
	<track type="data">
		<identifiers
			system			="PLAYSTATION"
			volume			="SLIPWAYS"
			volume_set		="SLIPWAYS"
			publisher		="SLIPWAYS"
			data_preparer	="PSN00BSDK ${PSN00BSDK_VERSION}"
			application		="PLAYSTATION"
		/>
		<!-- File names must be 8.3: the BIOS's ISO 9660 reader finds nothing else. -->
		<directory_tree>
			<file name="SYSTEM.CNF"		type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="SLIPWAYS.EXE"	type="data" source="psx-game.exe" />
			<dummy sectors="1024"/>
		</directory_tree>
	</track>
</iso_project>
