+static uint32_t screen_hash(void) {
+    uint32_t h = 2166136261u;
+    int i;
+
+    for (i = 0; i < PICO8_SCREEN_WIDTH * PICO8_SCREEN_HEIGHT; i++) {
+        h ^= (uint32_t)pico8_peek(&mem, PICO8_ADDR_SCREEN + i);
+        h *= 16777619u;
+    }
+    return h;
+}
